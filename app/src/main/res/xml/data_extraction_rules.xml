<?xml version="1.0" encoding="utf-8"?>
<!-- Photos of the user's home never leave this device, including via OS backup. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
